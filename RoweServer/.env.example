# RoweServer configuration — copy to .env and replace ROWE_JWT_SECRET before deploying
ROWE_ADDR=:8080
ROWE_DB_PATH=/data/rowe.db
# Generate with: openssl rand -hex 32
ROWE_JWT_SECRET=replace-with-at-least-32-random-characters-before-production
ROWE_CORS_ORIGINS=*
ROWE_RATE_LIMIT_PER_MIN=180
ROWE_AUTH_RATE_PER_MIN=20
